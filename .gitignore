manuals/*
!manuals/README.md
# Both forms. With only the trailing slash this matches a directory and not a symlink, and a
# worktree given `ln -s .../node_modules` then slips one past `git add -A` — which is how an
# absolute path from one laptop reached main in 3d7682f.
node_modules
node_modules/

# next.js
.next/
out/

# typescript
*.tsbuildinfo

# vercel
.vercel/

# next-env.d.ts is generated, and its contents differ depending on whether `next dev` or
# `next build` ran last (.next/dev/types vs .next/types), so committing it dirties the tree
# on every switch between the two. It is not needed for `tsc --noEmit` on a clean checkout:
# next.config.ts imports from 'next', which pulls the same global declarations into the
# program. If that ever stops being true, typecheck fails loudly in CI rather than drifting.
next-env.d.ts

# local env
.env*.local
