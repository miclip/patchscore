{
  "name": "patchscore",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic hardware-rig production guide generator",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:registry": "tsx scripts/gen-registry.ts",
    "check:registry": "tsx scripts/gen-registry.ts --check",
    "prebuild": "tsx scripts/gen-registry.ts",
    "guide": "tsx scripts/guide.ts",
    "audit": "tsx scripts/audit-verified.ts",
    "bench:search": "tsx scripts/bench-search.ts",
    "bench:decomposition": "tsx scripts/bench-decomposition.ts",
    "bench:search-shape": "tsx scripts/bench-search-shape.ts",
    "bench:bound": "tsx scripts/bench-bound.ts",
    "bench:client-resolve": "tsx scripts/bench-client-resolve.ts",
    "verify": "npm run typecheck && npm run test",
    "gen:golden": "tsx test/golden/generate.ts --write",
    "gen:guides": "tsx test/golden/guides.ts --write"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  }
}
